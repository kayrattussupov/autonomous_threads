# Postgres
DATABASE_URL=postgresql+psycopg://threads_agent:changeme@postgres:5432/threads_agent
POSTGRES_USER=threads_agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=threads_agent

# LLM providers (config/models.yaml references these key names)
GLM_API_KEY=
KIMI_API_KEY=

# Threads official API (Graph API)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=

# Threads browser reading — credentials for the account src/threads/browser
# logs into with Selenium to scrape the public feed (login is cookie-first;
# these are only used as a fallback when data/threads_cookies.json is
# missing/expired). Never used for posting — that's the Graph API above.
THREADS_USERNAME=
THREADS_PASSWORD=

# Airtable (source for T1.6 one-time import only)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appETFU4HKHySQIxi
AIRTABLE_TABLE_NAME=tblgBubbkIJSiu6Af

# Web search for content_agent's category='news' posts
TAVILY_API_KEY=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API
API_BEARER_TOKEN=changeme
